# URL pública do backend responsável por criar sessões no provedor de pagamento.
# Segredos e chaves privadas nunca devem ser definidos em variáveis VITE_*.
VITE_BILLING_API_URL=https://api.example.com/billing

# Configuração pública do aplicativo web no Firebase. Nunca use chaves de conta de serviço aqui.
VITE_FIREBASE_API_KEY=public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# URL final onde esta aplicação será publicada. Usada em canonical, sitemap e previews sociais.
VITE_PUBLIC_SITE_URL=https://tools.example.com
